PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campus_hustle
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Address(es) of the website that talks to this API (comma-separated). Used for CORS and the WebSocket origin check.
# On Render this is filled in automatically if you serve the frontend from the same service.
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary (image storage): Dashboard -> "API Keys"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: restrict sign-up to campus emails, e.g. youruni.edu.in (leave blank to allow any email)
ALLOWED_EMAIL_DOMAIN=

NODE_ENV=development
